generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  companyUsers CompanyUser[]
  quotes       Quote[]

  taskLists     TaskList[]
  ownedTasks    Task[]             @relation("TaskOwner")
  assignedTasks Task[]             @relation("TaskAssignee")
  notes         Note[]
  comments      Comment[]
  tags          Tag[]
  attachments   Attachment[]
  integrations  UserIntegration[]
  pushSubs      PushSubscription[]
  timeEntries   TimeEntry[]

  /// Token voor de persoonlijke ICS-agendafeed. Los van de sessie zodat
  /// Google/Apple 'm kan blijven ophalen zonder in te loggen.
  calendarFeedToken String? @unique
}

enum UserRole {
  ADMIN
  EDITOR
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  branding       Json     @default("{}")
  settings       Json     @default("{}")
  termsContent   String?  @db.Text
  privacyContent String?  @db.Text
  termsPdfKey    String?  @db.Text
  termsPdfName   String?
  termsPdfSize   Int?
  privacyPdfKey  String?  @db.Text
  privacyPdfName String?
  privacyPdfSize Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            CompanyUser[]
  customers        Customer[]
  products         Product[]
  productSets      ProductSet[]
  quotes           Quote[]
  datasheets       Datasheet[]
  findings         ResearchFinding[]
  adviceReports    AdviceDocument[]
  projects         Project[]
  workOrders       WorkOrder[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  calculations     Calculation[]
  productDocuments ProductDocument[]
  quoteTemplates   QuoteTemplate[]

  taskLists    TaskList[]
  tasks        Task[]
  notes        Note[]
  tags         Tag[]
  attachments  Attachment[]
  contracts    Contract[]
  portalAccess PortalAccess[]
  reviewBoards ReviewBoard[]
  timeEntries  TimeEntry[]
}

model CompanyUser {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(EDITOR)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ─── Customers ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  zipCode   String?
  notes     String?  @db.Text
  kvk       String?
  vatNumber String?
  iban      String?
  type      String?  @default("KLANT") // KLANT | LEVERANCIER | BEIDE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  adviceReports AdviceDocument[]
  projects      Project[]
  salesInvoices SalesInvoice[]
  calculations  Calculation[]
  tasks         Task[]
  customerNotes Note[]
  contracts     Contract[]
  portalAccess  PortalAccess[]

  @@index([companyId])
}

// ─── Products & Sets ───────────────────────────────────────────────────────

model Product {
  id                   String    @id @default(cuid())
  companyId            String
  datasheetId          String?   @unique
  category             String
  name                 String
  description          String?   @db.Text
  unit                 String    @default("stuk")
  basePrice            Decimal   @default(0) @db.Decimal(10, 2)
  basePriceAuto        Boolean   @default(true)
  costPrice            Decimal?  @db.Decimal(10, 2)
  vatRate              Decimal   @default(21) @db.Decimal(5, 2)
  supplier             String?
  sku                  String?
  ean                  String?
  priceUpdatedAt       DateTime?
  defaultMarkupPercent Decimal?  @default(25) @db.Decimal(5, 2)
  laborHours           Decimal?  @db.Decimal(5, 2)
  specs                Json      @default("{}")
  active               Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  datasheet        Datasheet?        @relation(fields: [datasheetId], references: [id], onDelete: SetNull)
  quoteItems       QuoteItem[]
  setItems         ProductSetItem[]
  calculationItems CalculationItem[]
  documents        ProductDocument[]

  @@index([companyId, active])
  @@index([companyId, supplier])
}

// ─── Datasheets & brochures (bestanden) ────────────────────────────────────

model ProductDocument {
  id        String              @id @default(cuid())
  companyId String
  productId String
  name      String
  objectKey String
  mimeType  String?
  size      Int?
  type      ProductDocumentType @default(DATASHEET)
  createdAt DateTime            @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quoteDocuments QuoteDocument[]

  @@index([productId])
  @@index([companyId])
}

enum ProductDocumentType {
  DATASHEET
  BROCHURE
}

model QuoteDocument {
  id                String   @id @default(cuid())
  quoteId           String
  productDocumentId String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  quote           Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productDocument ProductDocument @relation(fields: [productDocumentId], references: [id], onDelete: Cascade)

  @@unique([quoteId, productDocumentId])
}

model ProductSet {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  category    String?
  laborHours  Decimal? @default(0) @db.Decimal(5, 2)
  laborRate   Decimal? @default(65) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ProductSetItem[]
}

model ProductSetItem {
  id        String  @id @default(cuid())
  setId     String
  productId String
  qty       Decimal @default(1) @db.Decimal(10, 2)
  notes     String?
  sortOrder Int     @default(0)

  set     ProductSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Quotes ────────────────────────────────────────────────────────────────

model Quote {
  id                       String      @id @default(cuid())
  companyId                String
  customerId               String
  createdById              String
  number                   String
  title                    String?     @default("Persoonlijk voorstel")
  category                 String?     @default("Maatwerk project")
  tagline                  String?     @default("Ontwerp · Bouw · Plaatsing")
  itemsHeader              String?     @default("Onderdelen binnen fase 1.")
  status                   QuoteStatus @default(DRAFT)
  quoteType                String?     @default("GENERAL")
  validUntil               DateTime?
  intro                    String?     @db.Text
  outro                    String?     @db.Text
  notes                    String?     @db.Text
  vatRate                  Decimal     @default(21) @db.Decimal(5, 2)
  discount                 Decimal     @default(0) @db.Decimal(10, 2)
  totalExVat               Decimal     @default(0) @db.Decimal(10, 2)
  totalVat                 Decimal     @default(0) @db.Decimal(10, 2)
  totalIncVat              Decimal     @default(0) @db.Decimal(10, 2)
  flow                     Json?       @default("[]")
  approach                 Json?       @default("[]")
  options                  Json?       @default("[]")
  exclusions               Json?       @default("[]")
  assumptions              Json?       @default("[]")
  technicalNotes           Json?       @default("[]")
  customerResponsibilities Json?       @default("[]")
  planning                 Json?       @default("{}")
  commercial               Json?       @default("{}")
  batteryAdvice            Json?       @default("{}")
  choiceGroups             Json?       @default("[]") // [{ id: "g1", title: "Kies uw optie", type: "SINGLE_SELECT" }]
  internalAdvice           String?     @db.Text
  document                 Json?
  documentRevision         Int         @default(0)
  version                  Int         @default(1)
  pdfUrl                   String?
  projectId                String?
  sentAt                   DateTime?
  lastSentAt               DateTime?
  sendCount                Int         @default(0)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  attachments     QuoteAttachment[]
  adviceDocuments AdviceDocument[]
  share           QuoteShare?
  findings        ResearchFinding[]
  salesInvoices   SalesInvoice[]
  calculation     Calculation?
  documents       QuoteDocument[]
  tasks           Task[]
  contracts       Contract[]
  events          QuoteEvent[]

  @@index([companyId, updatedAt(sort: Desc)])
  @@index([companyId, status])
}

model QuoteTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  category    String?
  document    Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, updatedAt(sort: Desc)])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── Projects ──────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  number      String // bijv. KI-2026-P001
  title       String
  description String?   @db.Text
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | ARCHIVED
  address     String?
  city        String?
  zipCode     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  quotes           Quote[]
  files            ProjectFile[]
  workOrders       WorkOrder[]
  invoices         SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  calculations     Calculation[]
  tasks            Task[]
  notes            Note[]
  contracts        Contract[]
  portalAccess     PortalAccess[]
  reviewBoards     ReviewBoard[]
  timeEntries      TimeEntry[]

  /// Waar staat de site die de klant mag reviewen (fase 6).
  previewUrl String? @db.Text

  @@index([companyId])
}

model WorkOrder {
  id             String    @id @default(cuid())
  companyId      String
  projectId      String
  number         String // bijv. KI-2026-W001
  title          String
  description    String?   @db.Text
  status         String    @default("CONCEPT") // CONCEPT | GEPLAND | UITGEVOERD | GEFACTUREERD
  scheduledAt    DateTime?
  executedAt     DateTime?
  technicianName String?

  // Handtekening klant (objectKey in MinIO)
  signatureKey String?
  signedAt     DateTime?
  signedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines         WorkOrderLine[]
  salesInvoices SalesInvoice[]

  @@index([projectId])
  @@index([companyId])
}

model WorkOrderLine {
  id          String   @id @default(cuid())
  workOrderId String
  type        String   @default("MATERIAAL") // MATERIAAL | ARBEID
  description String   @db.Text
  qty         Decimal  @default(1) @db.Decimal(10, 2)
  unit        String?  @default("stuk") // stuk, m, uur
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  sortOrder   Int      @default(0)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model SalesInvoice {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  projectId   String?
  quoteId     String? // gegenereerd vanuit offerte
  workOrderId String? // of vanuit werkbon
  number      String // bijv. KI-2026-F001
  status      String    @default("CONCEPT") // CONCEPT | VERZONDEN | BETAALD | VERVALLEN
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  notes       String?   @db.Text
  reference   String? // bijv. PO-nummer klant

  totalExVat  Decimal @default(0) @db.Decimal(10, 2)
  totalVat    Decimal @default(0) @db.Decimal(10, 2)
  totalIncVat Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote     Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  lines     InvoiceLine[]

  @@index([companyId])
  @@index([projectId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String  @db.Text
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unit        String? @default("stuk")
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  vatRate     Decimal @default(21) @db.Decimal(5, 2)
  sortOrder   Int     @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PurchaseInvoice {
  id            String    @id @default(cuid())
  companyId     String
  projectId     String?
  supplierName  String
  invoiceNumber String?
  invoiceDate   DateTime?
  amount        Decimal   @default(0) @db.Decimal(10, 2) // bedrag excl. btw
  vatAmount     Decimal?  @db.Decimal(10, 2)
  status        String    @default("ONTVANGEN") // ONTVANGEN | GEBOEKT | BETAALD
  fileKey       String? // scan/foto in MinIO
  fileName      String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  objectKey  String // MinIO/S3 object key
  mimeType   String?
  size       Int?
  category   String?  @default("OVERIG") // OFFERTE | WERKBON | FACTUUR | FOTO | OVERIG
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model QuoteItem {
  id            String   @id @default(cuid())
  quoteId       String
  productId     String?
  description   String   @db.Text
  qty           Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2)
  vatRate       Decimal  @default(21) @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  indent        Int      @default(0)
  type          String?  @default("main")
  choiceGroupId String?
  hiddenOnQuote Boolean  @default(false)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

// ─── Advice Documents ──────────────────────────────────────────────────────

model QuoteAttachment {
  id        String   @id @default(cuid())
  quoteId   String
  title     String?
  imageUrl  String   @db.Text
  liveUrl   String?  @db.Text
  caption   String?  @db.Text
  section   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model AdviceDocument {
  id         String     @id @default(cuid())
  quoteId    String? // Optioneel: pas gekoppeld na generatie offerte
  customerId String
  companyId  String
  type       AdviceType @default(BATTERY)
  status     String     @default("DRAFT") // DRAFT, SENT, CONVERTED
  title      String     @default("Energie-advies Thuisbatterij")

  // Intake & Situatie
  inputData   Json? // Ruwe intake data
  consumption Json? // { annualKwh, nightKwh, solarWp, exportedKwh, phase: 1|3 }

  // Analyse & Onderbouwing
  summary     String? @db.Text
  analysis    String? @db.Text
  calculation Json? // De stappen van de berekening

  // Scenario's & Aanbeveling
  scenarios      Json? // Array van scenario's (Basis, Comfort, Maximaal)
  recommendation String? @db.Text

  // Specifieke Modules
  financial   Json? // { conservative, realistic, optimistic }
  backup      Json? // Back-up analyse
  ems         Json? // EMS analyse & noodzaak
  currentDevs Json? // Actuele ontwikkelingen (salderen etc)

  content   String?  @db.Text // Volledige gegenereerde tekst (fallback)
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
}

enum AdviceType {
  BATTERY
  EMS
  SOLAR
  ELECTRICAL
  CAMERA
  HEATPUMP
}

// ─── Knowledge Base ────────────────────────────────────────────────────────

model Datasheet {
  id        String   @id @default(cuid())
  companyId String
  brand     String
  model     String
  category  String?
  specs     Json     @default("{}")
  notes     String?  @db.Text
  price     Decimal? @db.Decimal(10, 2)
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product?

  @@unique([companyId, brand, model])
}

model ResearchFinding {
  id        String   @id @default(cuid())
  companyId String
  topic     String
  content   String   @db.Text
  tags      String[]
  quoteId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// ─── Quote Sharing (klantportaal) ──────────────────────────────────────────

model QuoteShare {
  id                  String    @id @default(cuid())
  quoteId             String    @unique
  token               String    @unique @default(uuid())
  viewedAt            DateTime?
  lastViewedAt        DateTime?
  viewCount           Int       @default(0)
  acceptedAt          DateTime?
  declinedAt          DateTime?
  signerName          String?
  selectedChoiceIds   Json?     @default("{}")
  selectedOptionIds   Json?     @default("[]")
  acceptedTotalExVat  Decimal?  @db.Decimal(10, 2)
  acceptedTotalVat    Decimal?  @db.Decimal(10, 2)
  acceptedTotalIncVat Decimal?  @db.Decimal(10, 2)
  acceptanceSnapshot  Json?
  message             String?   @db.Text
  portalPdfUrl        String?   @db.Text
  createdAt           DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  type      String // SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED
  detail    String?  @db.Text
  actor     String?
  userAgent String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

// ─── Calculations ───────────────────────────────────────────────────────────

model Calculation {
  id          String            @id @default(cuid())
  companyId   String
  customerId  String?
  projectId   String?
  quoteId     String?           @unique
  number      String // bijv. KI-2026-C001
  title       String
  description String?           @db.Text
  status      CalculationStatus @default(DRAFT)
  vatRate     Decimal           @default(21) @db.Decimal(5, 2)

  // Totale kosten, verkoop en marges
  totalCostPrice  Decimal @default(0) @db.Decimal(10, 2)
  totalSalesPrice Decimal @default(0) @db.Decimal(10, 2)
  marginAmount    Decimal @default(0) @db.Decimal(10, 2)
  marginPercent   Decimal @default(0) @db.Decimal(5, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project  Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote    Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items    CalculationItem[]

  @@index([companyId])
}

enum CalculationStatus {
  DRAFT
  COMPLETED
  QUOTED
}

model CalculationItem {
  id              String              @id @default(cuid())
  calculationId   String
  productId       String?
  type            CalculationItemType @default(MATERIAL)
  supplier        String?
  sku             String?
  description     String              @db.Text
  qty             Decimal             @default(1) @db.Decimal(10, 2)
  unit            String?             @default("stuk")
  costPrice       Decimal             @default(0) @db.Decimal(10, 2)
  markupPercent   Decimal             @default(0) @db.Decimal(5, 2)
  unitPrice       Decimal             @default(0) @db.Decimal(10, 2)
  totalCostPrice  Decimal             @default(0) @db.Decimal(10, 2)
  totalSalesPrice Decimal             @default(0) @db.Decimal(10, 2)
  vatRate         Decimal             @default(21) @db.Decimal(5, 2)
  optional        Boolean             @default(false)
  hiddenOnQuote   Boolean             @default(false)
  sortOrder       Int                 @default(0)

  calculation Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([calculationId])
}

enum CalculationItemType {
  MATERIAL
  LABOR
  CUSTOM
  SET
}

// ─── Werkplek: taken, notities, bijlagen ───────────────────────────────────
//
// Scope-regel: companyId = null betekent PRIVÉ (hangt alleen aan ownerId).
// Alle bestaande queries filteren op companyId, dus privédata kan per
// constructie niet in een zakelijk overzicht opduiken. Zie src/lib/tasks.ts.

model TaskList {
  id         String    @id @default(cuid())
  companyId  String? // null = privé
  ownerId    String
  name       String
  kind       String    @default("LIST") // LIST | SHOPPING | BOARD
  icon       String? // lucide-icoonnaam
  color      String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([companyId])
  @@index([ownerId])
}

model Task {
  id        String  @id @default(cuid())
  companyId String? // null = privé
  ownerId   String
  listId    String?

  // Koppelingen zijn allemaal optioneel — een taak mag los bestaan.
  projectId     String?
  customerId    String?
  quoteId       String?
  reviewBoardId String?

  title       String
  description String? @db.Text
  status      String  @default("OPEN") // OPEN | DOING | WAITING | DONE | CANCELLED
  priority    Int     @default(0) // 0 normaal | 1 hoog | 2 urgent

  // Agenda
  startAt  DateTime?
  endAt    DateTime?
  allDay   Boolean   @default(false)
  dueAt    DateTime?
  remindAt DateTime?

  // Herhaling
  recurRule    String? // subset RRULE: FREQ=YEARLY;INTERVAL=1
  recurUntil   DateTime?
  parentTaskId String? // uit welke herhaling gegenereerd

  // Externe agenda (fase 3)
  calendarEventId  String?
  calendarSyncedAt DateTime?

  // Review-pin (fase 6): { url, selector, xPct, yPct, scrollY, viewport, thumbKey, deployId }
  pin Json?

  source       String  @default("MANUAL") // MANUAL | PORTAL_PIN | PORTAL_MESSAGE | EMAIL | AI | RECURRING
  visibility   String  @default("INTERNAL") // INTERNAL | SHARED
  assignedToId String? // toekomst: personeel/onderaannemer

  sortOrder   Int       @default(0)
  completedAt DateTime?
  deletedAt   DateTime? // prullenbak
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedTo  User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  list        TaskList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  reviewBoard ReviewBoard? @relation(fields: [reviewBoardId], references: [id], onDelete: Cascade)
  comments    Comment[]
  attachments Attachment[]
  tags        TagOnTask[]
  timeEntries TimeEntry[]

  @@index([companyId, status])
  @@index([ownerId, status])
  @@index([listId, sortOrder])
  @@index([projectId])
  @@index([dueAt])
}

model Note {
  id         String  @id @default(cuid())
  companyId  String? // null = privé
  ownerId    String
  projectId  String?
  customerId String?

  title      String?
  body       String  @db.Text // markdown
  pinned     Boolean @default(false)
  visibility String  @default("INTERNAL") // INTERNAL | SHARED

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  tags        TagOnNote[]

  @@index([companyId, updatedAt(sort: Desc)])
  @@index([ownerId, updatedAt(sort: Desc)])
}

// Gespreksregel onder een taak. Wordt in fase 5 hergebruikt voor klantfeedback:
// een INTERNAL comment op een gedeelde taak is mijn eigen kladblok, klant ziet 'm niet.
model Comment {
  id     String @id @default(cuid())
  taskId String

  authorUserId   String? // ik
  authorPortalId String? // klant, via PortalAccess
  authorName     String // gedenormaliseerd voor weergave

  body       String @db.Text
  visibility String @default("INTERNAL") // INTERNAL | SHARED

  createdAt DateTime @default(now())

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUser   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorPortal PortalAccess? @relation(fields: [authorPortalId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([taskId, createdAt])
}

// Nullable FK's i.p.v. polymorfie — zelfde patroon als SalesInvoice.quoteId?/workOrderId?.
model Attachment {
  id        String  @id @default(cuid())
  companyId String?

  taskId     String?
  noteId     String?
  commentId  String?
  contractId String?

  objectKey String @db.Text // MinIO
  fileName  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?

  uploadedByUserId String?
  uploadedByName   String? // klantnaam als het uit het portaal komt
  createdAt        DateTime @default(now())

  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note           Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  comment        Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  contract       Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedByUser User?     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([noteId])
  @@index([commentId])
}

model Tag {
  id        String  @id @default(cuid())
  companyId String? // null = privé
  ownerId   String
  name      String
  color     String?

  createdAt DateTime @default(now())

  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks   TagOnTask[]
  notes   TagOnNote[]

  @@unique([ownerId, companyId, name])
  @@index([companyId])
}

model TagOnTask {
  tagId  String
  taskId String

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([tagId, taskId])
  @@index([taskId])
}

model TagOnNote {
  tagId  String
  noteId String

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([tagId, noteId])
  @@index([noteId])
}

// ─── Contracten (fase 4) ───────────────────────────────────────────────────

model Contract {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  projectId  String?
  quoteId    String?

  number String
  title  String
  body   String? @db.Text // markdown, leeg als het een geüploade PDF is
  status String  @default("CONCEPT") // CONCEPT | VERZONDEN | GETEKEND | ACTIEF | OPGEZEGD | VERLOPEN

  startDate        DateTime?
  endDate          DateTime?
  noticePeriodDays Int?
  autoRenew        Boolean   @default(false)
  renewalNoticeAt  DateTime? // wanneer moet ik erover nadenken → wordt een Task

  recurringAmount Decimal? @db.Decimal(10, 2)
  recurringPeriod String? // MONTH | QUARTER | YEAR

  // Ondertekening — hergebruikt de werkbon-handtekeningflow
  signatureKey String?   @db.Text
  signedAt     DateTime?
  signedBy     String?
  shareToken   String?   @unique @default(uuid())
  viewedAt     DateTime?

  pdfKey    String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote       Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  events      ContractEvent[]

  @@index([companyId, status])
  @@index([projectId])
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  type       String // CREATED | SENT | VIEWED | SIGNED | RENEWED | TERMINATED | NOTE
  detail     String?  @db.Text
  actor      String?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}

// ─── Klantportaal (fase 5) ─────────────────────────────────────────────────

model PortalAccess {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  projectId  String? // null = alle projecten van deze klant

  token String  @unique @default(uuid())
  email String?
  name  String?
  label String?

  canComment Boolean @default(true)
  canUpload  Boolean @default(true)

  lastSeenAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([customerId])
  @@index([projectId])
}

// ─── Review-tool (fase 6) ──────────────────────────────────────────────────

model ReviewBoard {
  id        String @id @default(cuid())
  companyId String
  projectId String

  name String
  kind String  @default("LIVE") // LIVE | IMAGE
  url  String? @db.Text

  imageKey    String? @db.Text
  imageWidth  Int?
  imageHeight Int?

  status    String   @default("OPEN") // OPEN | RESOLVED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pins    Task[]

  @@index([projectId])
}

// ─── Integraties & push (fase 3 + 7) ───────────────────────────────────────

model UserIntegration {
  id       String @id @default(cuid())
  userId   String
  provider String // GOOGLE_CALENDAR

  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  expiresAt         DateTime?
  calendarId        String?
  privateCalendarId String?
  syncToken         String?   @db.Text
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Tijdregistratie (fase 8, model nu al zodat het later geen migratie is) ─

model TimeEntry {
  id           String    @id @default(cuid())
  companyId    String
  userId       String
  taskId       String?
  projectId    String?
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int?
  note         String?   @db.Text
  billable     Boolean   @default(true)
  invoicedOnId String? // SalesInvoice waarin dit is meegenomen
  createdAt    DateTime  @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, startedAt])
  @@index([taskId])
}
