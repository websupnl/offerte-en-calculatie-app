generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  companyUsers CompanyUser[]
  quotes       Quote[]
}

enum UserRole {
  ADMIN
  EDITOR
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  branding       Json     @default("{}")
  settings       Json     @default("{}")
  termsContent   String?  @db.Text
  privacyContent String?  @db.Text
  termsPdfKey    String?  @db.Text
  termsPdfName   String?
  termsPdfSize   Int?
  privacyPdfKey  String?  @db.Text
  privacyPdfName String?
  privacyPdfSize Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users         CompanyUser[]
  customers     Customer[]
  products      Product[]
  productSets   ProductSet[]
  quotes        Quote[]
  datasheets    Datasheet[]
  findings         ResearchFinding[]
  adviceReports    AdviceDocument[]
  projects         Project[]
  workOrders       WorkOrder[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
}

model CompanyUser {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(EDITOR)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ─── Customers ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  zipCode   String?
  notes     String?  @db.Text
  kvk       String?
  vatNumber String?
  iban      String?
  type      String?  @default("KLANT") // KLANT | LEVERANCIER | BEIDE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  adviceReports AdviceDocument[]
  projects      Project[]
  salesInvoices SalesInvoice[]
}

// ─── Products & Sets ───────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  companyId   String
  datasheetId String?  @unique
  category    String
  name        String
  description String?  @db.Text
  unit        String   @default("stuk")
  basePrice   Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  vatRate     Decimal  @default(21) @db.Decimal(5, 2)
  specs       Json     @default("{}")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  datasheet  Datasheet?       @relation(fields: [datasheetId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]
  setItems   ProductSetItem[]
}

model ProductSet {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ProductSetItem[]
}

model ProductSetItem {
  id        String  @id @default(cuid())
  setId     String
  productId String
  qty       Decimal @default(1) @db.Decimal(10, 2)
  notes     String?
  sortOrder Int     @default(0)

  set     ProductSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Quotes ────────────────────────────────────────────────────────────────

model Quote {
  id                       String      @id @default(cuid())
  companyId                String
  customerId               String
  createdById              String
  number                   String
  title                    String?     @default("Persoonlijk voorstel")
  category                 String?     @default("Maatwerk project")
  tagline                  String?     @default("Ontwerp · Bouw · Plaatsing")
  itemsHeader              String?     @default("Onderdelen binnen fase 1.")
  status                   QuoteStatus @default(DRAFT)
  quoteType                String?     @default("GENERAL")
  validUntil               DateTime?
  intro                    String?     @db.Text
  outro                    String?     @db.Text
  notes                    String?     @db.Text
  vatRate                  Decimal     @default(21) @db.Decimal(5, 2)
  discount                 Decimal     @default(0) @db.Decimal(10, 2)
  totalExVat               Decimal     @default(0) @db.Decimal(10, 2)
  totalVat                 Decimal     @default(0) @db.Decimal(10, 2)
  totalIncVat              Decimal     @default(0) @db.Decimal(10, 2)
  flow                     Json?       @default("[]")
  approach                 Json?       @default("[]")
  options                  Json?       @default("[]")
  exclusions               Json?       @default("[]")
  assumptions              Json?       @default("[]")
  technicalNotes           Json?       @default("[]")
  customerResponsibilities Json?       @default("[]")
  planning                 Json?       @default("{}")
  commercial               Json?       @default("{}")
  batteryAdvice            Json?       @default("{}")
  choiceGroups             Json?       @default("[]") // [{ id: "g1", title: "Kies uw optie", type: "SINGLE_SELECT" }]
  internalAdvice           String?     @db.Text
  version                  Int         @default(1)
  pdfUrl                   String?
  projectId                String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  attachments     QuoteAttachment[]
  adviceDocuments AdviceDocument[]
  share           QuoteShare?
  findings        ResearchFinding[]
  salesInvoices   SalesInvoice[]
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── Projects ──────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  number      String // bijv. KI-2026-P001
  title       String
  description String?   @db.Text
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | ARCHIVED
  address     String?
  city        String?
  zipCode     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  quotes           Quote[]
  files            ProjectFile[]
  workOrders       WorkOrder[]
  invoices         SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]

  @@index([companyId])
}

model WorkOrder {
  id             String    @id @default(cuid())
  companyId      String
  projectId      String
  number         String // bijv. KI-2026-W001
  title          String
  description    String?   @db.Text
  status         String    @default("CONCEPT") // CONCEPT | GEPLAND | UITGEVOERD | GEFACTUREERD
  scheduledAt    DateTime?
  executedAt     DateTime?
  technicianName String?

  // Handtekening klant (objectKey in MinIO)
  signatureKey String?
  signedAt     DateTime?
  signedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines         WorkOrderLine[]
  salesInvoices SalesInvoice[]

  @@index([projectId])
  @@index([companyId])
}

model WorkOrderLine {
  id          String   @id @default(cuid())
  workOrderId String
  type        String   @default("MATERIAAL") // MATERIAAL | ARBEID
  description String   @db.Text
  qty         Decimal  @default(1) @db.Decimal(10, 2)
  unit        String?  @default("stuk") // stuk, m, uur
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  sortOrder   Int      @default(0)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model SalesInvoice {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  projectId   String?
  quoteId     String? // gegenereerd vanuit offerte
  workOrderId String? // of vanuit werkbon
  number      String // bijv. KI-2026-F001
  status      String    @default("CONCEPT") // CONCEPT | VERZONDEN | BETAALD | VERVALLEN
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  notes       String?   @db.Text
  reference   String? // bijv. PO-nummer klant

  totalExVat  Decimal @default(0) @db.Decimal(10, 2)
  totalVat    Decimal @default(0) @db.Decimal(10, 2)
  totalIncVat Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote     Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  lines     InvoiceLine[]

  @@index([companyId])
  @@index([projectId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String  @db.Text
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unit        String? @default("stuk")
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  vatRate     Decimal @default(21) @db.Decimal(5, 2)
  sortOrder   Int     @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PurchaseInvoice {
  id            String    @id @default(cuid())
  companyId     String
  projectId     String?
  supplierName  String
  invoiceNumber String?
  invoiceDate   DateTime?
  amount        Decimal   @default(0) @db.Decimal(10, 2) // bedrag excl. btw
  vatAmount     Decimal?  @db.Decimal(10, 2)
  status        String    @default("ONTVANGEN") // ONTVANGEN | GEBOEKT | BETAALD
  fileKey       String? // scan/foto in MinIO
  fileName      String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  objectKey  String // MinIO/S3 object key
  mimeType   String?
  size       Int?
  category   String?  @default("OVERIG") // OFFERTE | WERKBON | FACTUUR | FOTO | OVERIG
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model QuoteItem {
  id            String   @id @default(cuid())
  quoteId       String
  productId     String?
  description   String   @db.Text
  qty           Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2)
  vatRate       Decimal  @default(21) @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  indent        Int      @default(0)
  type          String?  @default("main")
  choiceGroupId String?

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ─── Advice Documents ──────────────────────────────────────────────────────

model QuoteAttachment {
  id        String   @id @default(cuid())
  quoteId   String
  title     String?
  imageUrl  String   @db.Text
  liveUrl   String?  @db.Text
  caption   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AdviceDocument {
  id         String     @id @default(cuid())
  quoteId    String? // Optioneel: pas gekoppeld na generatie offerte
  customerId String
  companyId  String
  type       AdviceType @default(BATTERY)
  status     String     @default("DRAFT") // DRAFT, SENT, CONVERTED
  title      String     @default("Energie-advies Thuisbatterij")

  // Intake & Situatie
  inputData   Json? // Ruwe intake data
  consumption Json? // { annualKwh, nightKwh, solarWp, exportedKwh, phase: 1|3 }

  // Analyse & Onderbouwing
  summary     String? @db.Text
  analysis    String? @db.Text
  calculation Json? // De stappen van de berekening

  // Scenario's & Aanbeveling
  scenarios      Json? // Array van scenario's (Basis, Comfort, Maximaal)
  recommendation String? @db.Text

  // Specifieke Modules
  financial   Json? // { conservative, realistic, optimistic }
  backup      Json? // Back-up analyse
  ems         Json? // EMS analyse & noodzaak
  currentDevs Json? // Actuele ontwikkelingen (salderen etc)

  content   String?  @db.Text // Volledige gegenereerde tekst (fallback)
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum AdviceType {
  BATTERY
  EMS
  SOLAR
  ELECTRICAL
  CAMERA
  HEATPUMP
}

// ─── Knowledge Base ────────────────────────────────────────────────────────

model Datasheet {
  id        String   @id @default(cuid())
  companyId String
  brand     String
  model     String
  category  String?
  specs     Json     @default("{}")
  notes     String?  @db.Text
  price     Decimal? @db.Decimal(10, 2)
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product?

  @@unique([companyId, brand, model])
}

model ResearchFinding {
  id        String   @id @default(cuid())
  companyId String
  topic     String
  content   String   @db.Text
  tags      String[]
  quoteId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}

// ─── Quote Sharing (klantportaal) ──────────────────────────────────────────

model QuoteShare {
  id                  String    @id @default(cuid())
  quoteId             String    @unique
  token               String    @unique @default(uuid())
  viewedAt            DateTime?
  acceptedAt          DateTime?
  declinedAt          DateTime?
  signerName          String?
  selectedChoiceIds   Json?     @default("{}")
  selectedOptionIds   Json?     @default("[]")
  acceptedTotalExVat  Decimal?  @db.Decimal(10, 2)
  acceptedTotalVat    Decimal?  @db.Decimal(10, 2)
  acceptedTotalIncVat Decimal?  @db.Decimal(10, 2)
  acceptanceSnapshot  Json?
  message             String?   @db.Text
  createdAt           DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}
