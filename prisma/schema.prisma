generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  companyUsers CompanyUser[]
  quotes       Quote[]
}

enum UserRole {
  ADMIN
  EDITOR
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  branding  Json     @default("{}")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         CompanyUser[]
  customers     Customer[]
  products      Product[]
  productSets   ProductSet[]
  quotes        Quote[]
  datasheets    Datasheet[]
  findings      ResearchFinding[]
  adviceReports AdviceDocument[]
}

model CompanyUser {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(EDITOR)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ─── Customers ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  zipCode   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  adviceReports AdviceDocument[]
}

// ─── Products & Sets ───────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  name        String
  description String?  @db.Text
  unit        String   @default("stuk")
  basePrice   Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  vatRate     Decimal  @default(21) @db.Decimal(5, 2)
  specs       Json     @default("{}")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems QuoteItem[]
  setItems   ProductSetItem[]
}

model ProductSet {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ProductSetItem[]
}

model ProductSetItem {
  id        String  @id @default(cuid())
  setId     String
  productId String
  qty       Decimal @default(1) @db.Decimal(10, 2)
  notes     String?
  sortOrder Int     @default(0)

  set     ProductSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Quotes ────────────────────────────────────────────────────────────────

model Quote {
  id                       String      @id @default(cuid())
  companyId                String
  customerId               String
  createdById              String
  number                   String
  title                    String?     @default("Persoonlijk voorstel")
  category                 String?     @default("Maatwerk project")
  tagline                  String?     @default("Ontwerp · Bouw · Plaatsing")
  itemsHeader              String?     @default("Onderdelen binnen fase 1.")
  status                   QuoteStatus @default(DRAFT)
  quoteType                String?     @default("GENERAL")
  validUntil               DateTime?
  intro                    String?     @db.Text
  outro                    String?     @db.Text
  notes                    String?     @db.Text
  vatRate                  Decimal     @default(21) @db.Decimal(5, 2)
  discount                 Decimal     @default(0) @db.Decimal(10, 2)
  totalExVat               Decimal     @default(0) @db.Decimal(10, 2)
  totalVat                 Decimal     @default(0) @db.Decimal(10, 2)
  totalIncVat              Decimal     @default(0) @db.Decimal(10, 2)
  flow                     Json?       @default("[]")
  approach                 Json?       @default("[]")
  options                  Json?       @default("[]")
  exclusions               Json?       @default("[]")
  assumptions              Json?       @default("[]")
  technicalNotes           Json?       @default("[]")
  customerResponsibilities Json?       @default("[]")
  planning                 Json?       @default("{}")
  commercial               Json?       @default("{}")
  batteryAdvice            Json?       @default("{}")
  choiceGroups             Json?       @default("[]") // [{ id: "g1", title: "Kies uw optie", type: "SINGLE_SELECT" }]
  internalAdvice           String?     @db.Text
  version                  Int         @default(1)
  pdfUrl                   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  items           QuoteItem[]
  attachments     QuoteAttachment[]
  adviceDocuments AdviceDocument[]
  share           QuoteShare?
  findings        ResearchFinding[]
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

model QuoteItem {
  id            String   @id @default(cuid())
  quoteId       String
  productId     String?
  description   String   @db.Text
  qty           Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2)
  vatRate       Decimal  @default(21) @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  indent        Int      @default(0)
  type          String?  @default("main")
  choiceGroupId String?

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ─── Advice Documents ──────────────────────────────────────────────────────

model QuoteAttachment {
  id        String   @id @default(cuid())
  quoteId   String
  title     String?
  imageUrl  String   @db.Text
  liveUrl   String?  @db.Text
  caption   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AdviceDocument {
  id         String     @id @default(cuid())
  quoteId    String? // Optioneel: pas gekoppeld na generatie offerte
  customerId String
  companyId  String
  type       AdviceType @default(BATTERY)
  status     String     @default("DRAFT") // DRAFT, SENT, CONVERTED
  title      String     @default("Energie-advies Thuisbatterij")

  // Intake & Situatie
  inputData   Json? // Ruwe intake data
  consumption Json? // { annualKwh, nightKwh, solarWp, exportedKwh, phase: 1|3 }

  // Analyse & Onderbouwing
  summary     String? @db.Text
  analysis    String? @db.Text
  calculation Json? // De stappen van de berekening

  // Scenario's & Aanbeveling
  scenarios      Json? // Array van scenario's (Basis, Comfort, Maximaal)
  recommendation String? @db.Text

  // Specifieke Modules
  financial   Json? // { conservative, realistic, optimistic }
  backup      Json? // Back-up analyse
  ems         Json? // EMS analyse & noodzaak
  currentDevs Json? // Actuele ontwikkelingen (salderen etc)

  content   String?  @db.Text // Volledige gegenereerde tekst (fallback)
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum AdviceType {
  BATTERY
  EMS
  SOLAR
  ELECTRICAL
  CAMERA
  HEATPUMP
}

// ─── Knowledge Base ────────────────────────────────────────────────────────

model Datasheet {
  id        String   @id @default(cuid())
  companyId String
  brand     String
  model     String
  category  String?
  specs     Json     @default("{}")
  notes     String?  @db.Text
  price     Decimal? @db.Decimal(10, 2)
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, brand, model])
}

model ResearchFinding {
  id        String   @id @default(cuid())
  companyId String
  topic     String
  content   String   @db.Text
  tags      String[]
  quoteId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}

// ─── Quote Sharing (klantportaal) ──────────────────────────────────────────

model QuoteShare {
  id                  String    @id @default(cuid())
  quoteId             String    @unique
  token               String    @unique @default(uuid())
  viewedAt            DateTime?
  acceptedAt          DateTime?
  declinedAt          DateTime?
  signerName          String?
  selectedChoiceIds   Json?     @default("{}")
  selectedOptionIds   Json?     @default("[]")
  acceptedTotalExVat  Decimal?  @db.Decimal(10, 2)
  acceptedTotalVat    Decimal?  @db.Decimal(10, 2)
  acceptedTotalIncVat Decimal?  @db.Decimal(10, 2)
  acceptanceSnapshot  Json?
  message             String?   @db.Text
  createdAt           DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}
